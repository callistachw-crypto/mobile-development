{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Image",
      "url": "https://raw.githubusercontent.com/ASUS/Documents/GitHub/mobile-development/main/icons/logo%20192x192.png",
      "size": "small",
      "style": "person"
    },
    {
      "type": "TextBlock",
      "text": "WuzzChat",
      "weight": "bolder",
      "size": "large",
      "color": "accent"
    },
    {
      "type": "TextBlock",
      "text": "Quick WhatsApp without saving contacts",
      "weight": "bolder",
      "size": "medium",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Recent: +628123456789",
      "spacing": "small",
      "size": "small",
      "isSubtle": true,
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "New Chat",
      "url": "/index.html"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Indonesia (+62)",
      "url": "/index.html?country=62"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Recent",
      "url": "/index.html#history"
    },
    {
      "type": "Action.OpenUrl",
      "title": "WhatsApp",
      "url": "https://wa.me/"
    }
  ]
}

