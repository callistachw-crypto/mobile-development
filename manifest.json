{
  "lang": "en",
  "dir": "ltr",
  "id": "com.wuzzchat.international",
  "scope": "/",
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://wa.me"
    }
  ],
  "name": "WuzzChat - Direct WhatsApp International",
  "short_name": "WuzzChat",
  "description": "Kirim pesan WhatsApp secara instan tanpa perlu simpan nomor. Mendukung kode negara internasional dengan fitur riwayat cepat.",
  "start_url": "./index.html",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#1a3a5a",
  "theme_color": "#1a3a5a",
  "orientation": "portrait",
  "categories": ["utilities", "productivity", "communication"],
  "iarc_rating_id": "e58c1174-81d2-4380-9993-9442ef572e92",

  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.whatsapp",
      "id": "com.whatsapp"
    }
  ],
  "prefer_related_applications": false,

  "icons": [
    {
      "src": "icons/logo 192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/logo 512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],

  "screenshots": [
    {
      "src": "icons/screenshots_mobile.png",
      "sizes": "1442x3203",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tampilan Mobile WuzzChat"
    },
    {
      "src": "icons/screenshots2.png",
      "sizes": "666x374",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tampilan Desktop WuzzChat"
    }
  ],

  "shortcuts": [
    {
      "name": "New Chat",
      "short_name": "New",
      "description": "Start new WhatsApp chat",
      "url": "./index.html",
      "icons": [
        {
          "src": "icons/logo 192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Note",
      "short_name": "Note",
      "description": "Create quick note to send via WhatsApp",
      "url": "./index.html?mode=note",
      "icons": [
        {
          "src": "icons/logo 192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Indonesia (+62)",
      "short_name": "ID",
      "description": "Indonesia numbers (+62)",
      "url": "./index.html?country=62",
      "icons": [
        {
          "src": "icons/logo 192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Recent",
      "short_name": "Recent",
      "description": "Open recent connections",
      "url": "./index.html#history",
      "icons": [
        {
          "src": "icons/logo 192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],

  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/vcard": [".vcf"],
        "text/plain": [".txt"]
      },
      "icons": [
        {
          "src": "icons/logo 192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],

  "launch_handler": {
    "client_mode": "focus-existing"
  },

  "protocol_handlers": [
    {
      "protocol": "web+wuzz",
      "title": "WuzzChat",
      "url": "./index.html?number=%s"
    }
  ],

  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "note_taking": {
    "url": "./index.html?mode=note",
    "label": "Send WhatsApp Note"
  }
}